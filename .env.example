# Copy this file to .env. Keep passwords in the connection URLs in sync with the variables below.
POSTGRES_DB=meteor
POSTGRES_USER=meteor_admin
POSTGRES_PASSWORD=change-this-local-dev-password
METEOR_APP_PASSWORD=change-this-runtime-password
PORT=8080
DATABASE_URL=postgresql://meteor_app:change-this-runtime-password@localhost:5433/meteor?sslmode=disable
MIGRATOR_DATABASE_URL=postgresql://meteor_admin:change-this-local-dev-password@localhost:5433/meteor?sslmode=disable
ERROR_LOG_PATH=logs/meteor-errors.log
