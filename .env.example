# Copy this file to .env. Keep passwords in the connection URLs in sync with the variables below.
POSTGRES_DB=meteor
POSTGRES_USER=meteor_admin
POSTGRES_PASSWORD=change-this-local-dev-password
METEOR_APP_PASSWORD=change-this-runtime-password
PORT=8080
DATABASE_URL=postgresql://meteor_app:change-this-runtime-password@localhost:5433/meteor?sslmode=disable
REDIS_URL=redis://localhost:6380/0
MIGRATOR_DATABASE_URL=postgresql://meteor_admin:change-this-local-dev-password@localhost:5433/meteor?sslmode=disable
ERROR_LOG_PATH=logs/meteor-errors.log
# Public API origin used for emailed auth links; set this to your API's ngrok URL for tunnel testing.
PUBLIC_BASE_URL=http://localhost:8080
# Exact browser origin allowed to call the API with dashboard session cookies.
DASHBOARD_ORIGIN=http://localhost:3000
# Keep DASHBOARD_ORIGIN set to the dashboard URL users open; PUBLIC_BASE_URL is the API tunnel.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=https://your-assigned-domain.ngrok-free.dev
# Configure Resend to enable email verification and password reset delivery.
RESEND_API_KEY=
RESEND_FROM=
# Set COOKIE_SECURE=true when serving the dashboard over HTTPS.
COOKIE_SECURE=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
# Use a randomly generated secret of at least 32 characters.
GITHUB_STATE_SECRET=
